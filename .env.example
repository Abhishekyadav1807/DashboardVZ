# ─── Database ───────────────────────────────────────────────────────────────
# Full Prisma connection string for PostgreSQL.
# Render PostgreSQL requires SSL — append ?sslmode=require if not already present.
DATABASE_URL="postgresql://velozity_user:velozity_pass@localhost:5432/velozity_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secret used to sign short-lived access tokens. Use a long random string in production.
JWT_ACCESS_SECRET="replace_with_a_long_random_access_secret"

# Secret used to sign refresh tokens (stored in HttpOnly cookie).
JWT_REFRESH_SECRET="replace_with_a_long_random_refresh_secret"

# Access token lifetime understood by jsonwebtoken (e.g. "15m", "1h")
ACCESS_TOKEN_EXPIRES_IN="15m"

# Refresh token lifetime (e.g. "7d", "30d")
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Deployed Vercel frontend origin — used for CORS and Socket.io origin allowlist
CLIENT_URL="http://localhost:5173"

# ─── Cookie ──────────────────────────────────────────────────────────────────
# Set to "true" in production (HTTPS). Enables Secure cookies and SameSite=None
# for cross-site requests between Vercel (frontend) and Render (backend).
COOKIE_SECURE="false"

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV="development"
